{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Avalisa PO Bot",
  "version": "2.4.19",
  "description": "Free demo, no payment to try. Automate Pocket Option trading with martingale or Avalisa Bot mode, under limits you set.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://po.cash/*",
    "https://po.trade/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://po.cash/*",
        "https://po.trade/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://po.cash/*",
        "https://po.trade/*"
      ],
      "js": [
        "signalEngine.js",
        "config.js",
        "state.js",
        "apiClient.js",
        "storage.js",
        "indicators.js",
        "poDom.js",
        "tradeResult.js",
        "overlayView.js",
        "claimFlow.js",
        "telemetry.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "icons/AvalisaBot_Logo.png",
        "icons/avalisa-signature-logo-gold.png",
        "icons/avalisa-signature-logo-transparent.png",
        "login.html",
        "login.js",
        "icons/avalisa-mascot.png"
      ],
      "matches": [
        "https://pocketoption.com/*",
        "https://po.cash/*",
        "https://po.trade/*"
      ]
    }
  ]
}
